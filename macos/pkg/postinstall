#!/bin/sh
# Runs as the user who installed the package (it installs into their home):
# the new copy is in ~/Library/Input Methods. Quits the old copy, registers
# and turns on the method, and selects it, as the app's own installer does.
# macOS 26 leaves a new input method for the person to add (--install exits
# 2): the method's own guide opens System Settings, waits for it and
# switches to it.
app="$HOME/Library/Input Methods/HaikuPinyin.app"
binary="$app/Contents/MacOS/HaikuPinyin"
[ -x "$binary" ] || { echo "postinstall: no $binary" >&2; exit 1; }
# The old one may still be running; the system starts the new one when it's used.
pkill -x -u "$(id -u)" HaikuPinyin 2>/dev/null || true
xattr -dr com.apple.quarantine "$app" 2>/dev/null || true
"$binary" --install
status=$?
"$binary" --select 2>/dev/null || true
# The input menu keeps the old copy's entry; launchd restarts it. Without
# this, apps (Slack) could find the method unusable until it was restarted.
killall TextInputMenuAgent 2>/dev/null || true
# In the person's session, through LaunchServices: a process started from
# here can't show a window.
[ "$status" = 2 ] && open -n "$app" --args --guide
exit 0
