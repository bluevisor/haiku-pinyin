<?xml version="1.0" encoding="utf-8"?>
<!-- IBus component for 海酷拼音 Haiku Pinyin; make install-ibus fills in the paths. -->
<component>
	<name>org.freedesktop.IBus.HaikuPinyin</name>
	<description>海酷拼音 Haiku Pinyin</description>
	<exec>@LIBEXECDIR@/ibus-engine-haiku-pinyin --ibus</exec>
	<version>@VERSION@</version>
	<author>John Zheng &lt;bluevisor@gmail.com&gt;</author>
	<license>GPL-3.0</license>
	<homepage>https://github.com/bluevisor/haiku-pinyin</homepage>
	<textdomain>haiku-pinyin</textdomain>
	<engines>
		<engine>
			<name>haiku-pinyin</name>
			<language>zh_CN</language>
			<license>GPL-3.0</license>
			<author>John Zheng &lt;bluevisor@gmail.com&gt;</author>
			<icon>@DATADIR@/icon.svg</icon>
			<layout>default</layout>
			<longname>海酷拼音 Haiku Pinyin</longname>
			<description>Chinese pinyin and shuangpin input: sentences, 联想, 模糊音, emoji, 简/繁</description>
			<rank>99</rank>
			<symbol>中</symbol>
			<setup>@LIBEXECDIR@/haiku-pinyin-setup</setup>
		</engine>
	</engines>
</component>
